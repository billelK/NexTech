{
  "name": "nextech",
  "main": "dist-electron/main.js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"npm run dev:electron\"",
    "dev:next": "next dev --webpack --hostname 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:3000 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "next build && npm run build:electron",
    "start": "cross-env NODE_ENV=production electron .",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^9.2.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "unrs-resolver@1.12.2": true
  }
}
